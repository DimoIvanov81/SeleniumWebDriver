pipeline {
    agent any

    stages {
        stage('Checkout the repository') {
            steps {
                checkout scm
            }
        }
        stage('Build the project') {
            steps {
                bat 'dotnet build'
            }
        }

        stage('Run parallel tests'){
            parallel {
                stage('Project1 tests') {
                    steps {
                        bat 'dotnet test TestProject1 --no-build --verbosity normal'
                    }
                }
                 stage('Project2 tests') {
                    steps {
                        bat 'dotnet test TestProject2 --no-build --verbosity normal'
                    }
                }
                 stage('Project3 tests') {
                    steps {
                        bat 'dotnet test TestProject3 --no-build --verbosity normal'
                    }
                }
            }
        }


    }

    post {
        always {
            echo 'Pipline completed'
        }
        success {
            echo 'Build succedded'
        }
        failure {
            echo 'Build failed'
        }
    }
}